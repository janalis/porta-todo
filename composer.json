{
    "name": "janalis/porta-todo",
    "description": "Scans the project for TODO and FIXME comments into a dock tool",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "psr-4": {
            "Porta\\Todo\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "store": {
                "title": "Todo",
                "category": "productivity"
            }
        }
    }
}
